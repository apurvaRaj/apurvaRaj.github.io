---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../../config/categories';

export function getStaticPaths() {
  return Object.keys(CATEGORIES).map((category) => ({ params: { category } }));
}
const { category } = Astro.params as { category: string };
const cat = CATEGORIES[category];
const articles = (await getCollection('insights', (e) => !e.data.draft && e.data.category === category)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title={`${cat.label} — Insights`} description={`Articles by Apurva Raj on ${cat.label.toLowerCase()}. ${cat.blurb}`} noindex={articles.length === 0}
  crumbs={[{ name: 'Insights', href: '/insights/' }, { name: cat.label, href: `/insights/category/${category}/` }]}>
  <header class="page-head">
    <div class="wrap">
      <nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="/insights/">Insights</a></li><li>Topic</li></ol></nav>
      <h1>{cat.label}</h1>
      <p class="lede">{cat.blurb}</p>
    </div>
  </header>
  <div class="wrap list">
    {articles.length === 0 ? (
      <p class="muted">No articles on this topic yet. <a href="/insights/">See all insights</a> or subscribe with <a href="/rss.xml">RSS</a>.</p>
    ) : (
      <ol>{articles.map((a) => <li><a href={`/insights/${a.id}/`}><time class="muted" datetime={a.data.date.toISOString()}>{fmt(a.data.date)}</time><b>{a.data.title}</b><span class="muted">{a.data.description}</span></a></li>)}</ol>
    )}
  </div>
</Base>
<style>
  .list { padding-block: 48px 120px; }
  ol { list-style: none; padding: 0; }
  li a { display: grid; gap: 6px; padding: 22px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  b { font: 650 var(--s1)/1.2 var(--display); }
</style>
