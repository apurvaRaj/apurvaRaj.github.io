---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../config/categories';
import { readingTime } from '../../scripts/reading';
const articles = (await getCollection('insights', (e) => !e.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const lessons = (await getCollection('learning')).sort((a, b) => b.data.day - a.data.day);
const counts = Object.fromEntries(Object.keys(CATEGORIES).map((c) => [c, articles.filter((a) => a.data.category === c).length]));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Insights" description="Technical insights by Apurva Raj on software architecture, Java and backend engineering, AI agents and LLM applications, blockchain, data engineering, cloud, fintech and engineering leadership." crumbs={[{ name: 'Insights', href: '/insights/' }]}>
  <header class="page-head">
    <div class="wrap">
      <h1>Insights</h1>
      <p class="lede">Notes from building real systems: architecture, AI agents, data, fintech and leading engineering teams.</p>
      <p class="feed"><a href="/rss.xml">Subscribe with RSS</a></p>
    </div>
  </header>
  <div class="wrap hub">
    <section aria-labelledby="latest">
      <h2 id="latest">Latest articles</h2>
      {articles.length === 0 ? (
        <p class="empty muted">The first articles are being written. Follow the <a href="/rss.xml">RSS feed</a> to get them as they’re published, or start with the learning log below.</p>
      ) : (
        <ol class="posts">
          {articles.map((a) => (
            <li>
              <a href={`/insights/${a.id}/`}>
                <span class="meta"><span>{CATEGORIES[a.data.category].label}</span> <time datetime={a.data.date.toISOString()}>{fmt(a.data.date)}</time> <span>{readingTime(a.body ?? '')} min read</span></span>
                <b>{a.data.title}</b>
                <span class="muted">{a.data.description}</span>
              </a>
            </li>
          ))}
        </ol>
      )}

      <h2 class="h-learn">Learning log</h2>
      <ol class="posts">
        {lessons.map((l) => (
          <li><a href={l.data.href}><span class="meta">Day {l.data.day} <time datetime={l.data.date.toISOString()}>{fmt(l.data.date)}</time></span><b>{l.data.title}</b><span class="muted">{l.data.description}</span></a></li>
        ))}
      </ol>
      <p><a href="/learning/">The full learning log</a></p>
    </section>
    <aside aria-labelledby="topics">
      <h2 id="topics">Topics</h2>
      <ul class="cats">
        {Object.entries(CATEGORIES).map(([slug, c]) => (
          <li><a href={`/insights/category/${slug}/`}><b>{c.label}</b><span class="muted">{counts[slug]} {counts[slug] === 1 ? 'article' : 'articles'}</span></a></li>
        ))}
      </ul>
    </aside>
  </div>
</Base>
<style>
  .feed { margin-top: 18px; font-size: var(--s-1); }
  .hub { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 56px clamp(32px, 6vw, 96px); padding-block: 56px 120px; }
  h2 { font-size: var(--s2); margin-bottom: 18px; }
  .h-learn { margin-top: 64px; }
  .empty { padding: 28px; border: 1px dashed var(--line-strong); border-radius: 14px; max-width: 60ch; }
  .posts { list-style: none; padding: 0; margin-bottom: 18px; }
  .posts > li > a { display: grid; gap: 8px; padding: 22px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .posts b { font: 650 var(--s1)/1.2 var(--display); }
  .meta { font-size: var(--s-1); color: var(--slate); display: flex; gap: 14px; flex-wrap: wrap; }
  .cats { list-style: none; padding: 0; display: grid; gap: 2px; }
  .cats a { display: flex; justify-content: space-between; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); text-decoration: none; font-size: var(--s-1); }
  @media (max-width: 900px) { .hub { grid-template-columns: 1fr; } }
</style>
