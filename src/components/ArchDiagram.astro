---
// Renders a project's architecture from frontmatter (nodes with x/y on a 1000×520 board, edges [from, to, label?]).
// Lines draw in when the figure scrolls into view (see .arch.in-view below). Static and complete without JS.
interface Node { id: string; label: string; x: number; y: number; kind: string }
interface Props { caption: string; nodes: Node[]; edges: string[][]; compact?: boolean; id?: string }
const { caption, nodes, edges, compact = false, id = 'arch' } = Astro.props;

const H = 56;
const width = (n: Node) => Math.max(120, Math.round(n.label.length * 7.4 + 34));
// keep every box inside the 1000×520 board, whatever its label length
const fit = (n: Node) => { const w = width(n); return { ...n, w, h: H, x: Math.min(1000 - 8 - w / 2, Math.max(8 + w / 2, n.x)), y: Math.min(520 - 8 - H / 2, Math.max(8 + H / 2, n.y)) }; };
const byId = Object.fromEntries(nodes.map((n) => [n.id, fit(n)]));
// point where the line from a's centre towards b leaves a's box
const exit = (a: any, b: any) => {
  const dx = b.x - a.x, dy = b.y - a.y;
  const sx = dx === 0 ? Infinity : (a.w / 2) / Math.abs(dx), sy = dy === 0 ? Infinity : (a.h / 2) / Math.abs(dy);
  const s = Math.min(sx, sy);
  return { x: a.x + dx * s, y: a.y + dy * s };
};
const lines = edges.map(([f, t, label], i) => {
  const a = byId[f], b = byId[t];
  if (!a || !b) return null;
  const p = exit(a, b), q = exit(b, a);
  const mx = (p.x + q.x) / 2, my = (p.y + q.y) / 2;
  return { d: `M${p.x.toFixed(1)},${p.y.toFixed(1)} L${q.x.toFixed(1)},${q.y.toFixed(1)}`, label, mx, my, i, text: `${a.label} to ${b.label}${label ? ` (${label})` : ''}` };
}).filter(Boolean) as any[];
const descId = `${id}-desc`;
---
<figure class:list={['arch', { compact }]} data-arch>
  <div class="arch-scroll">
    <svg viewBox="0 0 1000 520" role="img" aria-labelledby={`${id}-cap`} aria-describedby={descId}>
      <defs>
        <marker id={`${id}-arrow`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="currentColor" />
        </marker>
      </defs>
      <g class="edges">
        {lines.map((l) => (
          <g style={`--i:${l.i}`}>
            <path d={l.d} pathLength="1" marker-end={`url(#${id}-arrow)`} />
            {l.label && <text x={l.mx} y={l.my - 10} text-anchor="middle" class="edge-label">{l.label}</text>}
          </g>
        ))}
      </g>
      <g class="nodes">
        {Object.values(byId).map((n: any, i) => (
          <g class={`node k-${n.kind}`} style={`--i:${i}`} transform={`translate(${n.x - n.w / 2},${n.y - n.h / 2})`}>
            <rect width={n.w} height={n.h} rx={n.kind === 'actor' ? n.h / 2 : 10} />
            <text x={n.w / 2} y={n.h / 2 + 5} text-anchor="middle">{n.label}</text>
          </g>
        ))}
      </g>
    </svg>
  </div>
  <figcaption id={`${id}-cap`}>{caption}</figcaption>
  <ul id={descId} class="sr-only">{lines.map((l) => <li>{l.text}</li>)}</ul>
</figure>

<style>
  .arch { margin: 0; color: var(--blue); }
  .arch-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid var(--line); border-radius: 16px; background: radial-gradient(120% 90% at 50% 0%, rgba(91,140,255,.08), transparent 60%), rgba(11,18,34,.6); }
  .arch svg { width: 100%; min-width: 680px; height: auto; display: block; }
  .compact .arch-scroll { border: 0; background: none; overflow: visible; }
  .compact svg { min-width: 0; }
  figcaption { margin-top: 12px; font-size: var(--s-1); color: var(--slate); }
  .edges path { fill: none; stroke: currentColor; stroke-width: 1.6; opacity: .75; }
  .edge-label { fill: var(--slate); font: 500 13px var(--text); }
  .node rect { fill: #0E172B; stroke: var(--line-strong); stroke-width: 1.2; }
  .node text { fill: var(--ink); font: 600 14px var(--text); }
  .k-process rect { stroke: var(--blue); }
  .k-source rect { stroke-dasharray: 5 4; }
  .k-store rect { stroke: var(--blue); fill: #102041; }
  .k-surface rect { fill: var(--ink); stroke: var(--ink); }
  .k-surface text { fill: var(--void); }
  .k-actor rect { stroke: var(--slate); }
  .k-ledger rect { stroke: var(--amber); fill: #22190A; }
  .k-ledger text { fill: #FFE2B0; }

  /* draw-in, only when JS marks the figure as observed and motion is allowed */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .arch .edges path { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset .9s var(--ease-out) calc(var(--i) * 90ms + 250ms); }
    :global(.js) .arch .node { opacity: 0; transition: opacity .5s var(--ease-out) calc(var(--i) * 60ms); }
    :global(.js) .arch .edge-label { opacity: 0; transition: opacity .4s calc(var(--i) * 90ms + 700ms); }
    :global(.js) .arch.in-view .edges path { stroke-dashoffset: 0; }
    :global(.js) .arch.in-view .node, :global(.js) .arch.in-view .edge-label { opacity: 1; }
  }
</style>

<script>
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); } }), { threshold: 0.35 });
  document.querySelectorAll('[data-arch]').forEach((el) => io.observe(el));
</script>
