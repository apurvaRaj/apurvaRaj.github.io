---
import Base from '../../layouts/Base.astro';
import ArchDiagram from '../../components/ArchDiagram.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((p, i) => ({ params: { slug: p.id }, props: { p, next: projects[(i + 1) % projects.length] } }));
}
const { p, next } = Astro.props;
const { Content, headings } = await render(p);
const d = p.data;
const STATUS: Record<string, string> = { live: 'Live', 'in-development': 'In development', delivered: 'Delivered', academic: 'Academic project' };
const work = {
  '@type': 'CreativeWork', name: d.title, description: d.summary, url: new URL(`/projects/${p.id}/`, Astro.site).href,
  author: { '@id': new URL('/#person', Astro.site).href }, keywords: [...d.stack, ...d.keywords].join(', '),
};
---
<Base title={d.title.length > 56 ? `${d.short} case study` : d.title} description={d.summary} crumbs={[{ name: 'Projects', href: '/projects/' }, { name: d.short, href: `/projects/${p.id}/` }]} jsonld={[work]}>
  <header class="page-head case-head">
    <div class="wrap">
      <nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="/">Home</a></li><li><a href="/projects/">Projects</a></li><li>{d.short}</li></ol></nav>
      <p class="domain">{d.domain}</p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      <dl class="meta">
        <div><dt>Organisation</dt><dd>{d.org}</dd></div>
        <div><dt>Period</dt><dd>{d.period}</dd></div>
        <div><dt>My role</dt><dd>{d.role}</dd></div>
        <div><dt>Status</dt><dd>{STATUS[d.status]}</dd></div>
      </dl>
      {d.links.length > 0 && <p class="links">{d.links.map((l) => <a class="btn" href={l.href} rel="noopener">{l.label}</a>)}</p>}
    </div>
  </header>

  {d.facts.length > 0 && (
    <section class="wrap facts" aria-label="Key facts">
      {d.facts.map((f) => <div><b class="num">{f.value}</b><span>{f.label}</span></div>)}
    </section>
  )}

  {d.diagram && (
    <section class="wrap diagram" aria-labelledby="arch-title">
      <h2 id="arch-title" class="sr-only">Architecture</h2>
      <ArchDiagram caption={d.diagram.caption} nodes={d.diagram.nodes} edges={d.diagram.edges} id={`case-${p.id}`} />
    </section>
  )}

  <div class="wrap body">
    <aside class="side">
      <nav aria-label="On this page" class="toc">
        <p class="muted">On this page</p>
        <ol>{headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
      <div>
        <p class="muted">Technology</p>
        <ul class="chips">{d.stack.map((s) => <li>{s}</li>)}</ul>
      </div>
    </aside>
    <article class="prose"><Content /></article>
  </div>

  <nav class="wrap next" aria-label="Next case study">
    <a href={`/projects/${next.id}/`}><span class="muted">Next case study</span><b>{next.data.title}</b></a>
  </nav>
</Base>
<style>
  .case-head h1 { font-size: clamp(2.2rem, 5.6vw, 4.6rem); max-width: 20ch; }
  .domain { color: var(--amber); font-weight: 600; font-size: var(--s-1); margin-bottom: 14px; }
  .meta { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin-top: 40px; }
  .meta dt { font-size: var(--s-2); color: var(--slate); }
  .meta dd { margin: 4px 0 0; font-weight: 600; }
  .links { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 28px; }
  .facts { display: flex; gap: clamp(28px, 6vw, 96px); padding-block: 56px 0; flex-wrap: wrap; }
  .facts b { display: block; font: 720 clamp(2.4rem, 5vw, 4rem)/1 var(--display); }
  .facts span { color: var(--slate); font-size: var(--s-1); display: block; max-width: 28ch; margin-top: 8px; }
  .diagram { padding-block: 56px 0; }
  .body { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 40px clamp(32px, 6vw, 96px); padding-block: 72px 96px; }
  .side { display: grid; gap: 32px; align-content: start; position: sticky; top: 100px; align-self: start; }
  .toc ol { list-style: none; padding: 0; margin-top: 10px; display: grid; gap: 8px; font-size: var(--s-1); }
  .toc a { text-decoration: none; color: #C9D0DD; }
  .toc a:hover { color: var(--ink); }
  .side .chips { margin-top: 10px; }
  .next { padding-bottom: 120px; }
  .next a { display: grid; gap: 10px; padding: 40px 0; border-top: 1px solid var(--line); text-decoration: none; }
  .next b { font: 680 clamp(1.6rem, 3.4vw, 2.8rem)/1.05 var(--display); letter-spacing: -.025em; }
  @media (max-width: 900px) { .body { grid-template-columns: 1fr; } .side { position: static; } .meta { grid-template-columns: 1fr 1fr; } }
</style>
