---
import '../styles/global.css';
import { SITE, INTEGRATIONS, NAV } from '../config/site';

interface Crumb { name: string; href: string }
interface Props {
  title?: string;              // page title; site name is appended
  description?: string;
  image?: string;              // absolute or root-relative OG image
  type?: 'website' | 'article' | 'profile';
  jsonld?: Record<string, unknown>[];
  crumbs?: Crumb[];            // breadcrumb trail, excluding Home
  published?: Date;
  modified?: Date;
  noindex?: boolean;
  bodyClass?: string;
}
const {
  title, description = SITE.description, image = '/og/default.png', type = 'website',
  jsonld = [], crumbs = [], published, modified, noindex = false, bodyClass = '',
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const path = Astro.url.pathname;

const person = {
  '@type': 'Person', '@id': new URL('/#person', Astro.site).href, name: SITE.name,
  jobTitle: 'Co-Founder & CTO', worksFor: { '@type': 'Organization', name: 'FidelFolio Investments', url: 'https://fidelfolio.com' },
  url: new URL('/', Astro.site).href, email: `mailto:${SITE.email}`,
  sameAs: [SITE.links.linkedin, SITE.links.github],
  address: { '@type': 'PostalAddress', addressLocality: 'Bengaluru', addressCountry: 'IN' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Indian Institute of Technology Patna' },
    { '@type': 'CollegeOrUniversity', name: 'IIIT Bangalore' },
    { '@type': 'CollegeOrUniversity', name: 'JNN College of Engineering' },
  ],
  knowsAbout: ['Agentic AI', 'LLM applications', 'Enterprise architecture', 'Backend engineering', 'Java', 'Python', 'Blockchain', 'Hyperledger Fabric', 'R3 Corda', 'Fintech', 'Data engineering'],
};
const website = { '@type': 'WebSite', '@id': new URL('/#website', Astro.site).href, url: new URL('/', Astro.site).href, name: SITE.name, publisher: { '@id': person['@id'] }, inLanguage: 'en' };
const breadcrumb = crumbs.length
  ? { '@type': 'BreadcrumbList', itemListElement: [{ name: 'Home', href: '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, Astro.site).href })) }
  : null;
const graph = { '@context': 'https://schema.org', '@graph': [person, website, ...(breadcrumb ? [breadcrumb] : []), ...jsonld] };
---
<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="author" content={SITE.name} />
  <meta name="theme-color" content="#06080F" />
  <meta name="color-scheme" content="dark" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: Insights`} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={SITE.locale} />
  {published && <meta property="article:published_time" content={published.toISOString()} />}
  {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  {INTEGRATIONS.googleVerification && <meta name="google-site-verification" content={INTEGRATIONS.googleVerification} />}
  {INTEGRATIONS.bingVerification && <meta name="msvalidate.01" content={INTEGRATIONS.bingVerification} />}
  {INTEGRATIONS.ga4 && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${INTEGRATIONS.ga4}`}></script>
      <script is:inline define:vars={{ id: INTEGRATIONS.ga4 }}>
        window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', id, { anonymize_ip: true });
      </script>
    </>
  )}
  <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  <slot name="head" />
</head>
<body class={bodyClass}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="nav" data-nav>
    <div class="wrap">
      <a class="brand" href="/" aria-label={`${SITE.name}, home`}><span class="brand-mark" aria-hidden="true"></span>APURVA RAJ</a>
      <nav aria-label="Main">
        <ul>
          {NAV.map((n) => (
            <li class={n.href === '/about/' || n.href === '/experience/' ? 'hide-sm' : ''}><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
          ))}
          <li><a class="cta" href="/#contact">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="footer">
    <div class="wrap">
      <span>© {new Date().getFullYear()} {SITE.name}, {SITE.location}</span>
      <nav aria-label="Footer">
        <a href="/projects/">Work</a><a href="/experience/">Experience</a><a href="/insights/">Insights</a><a href="/learning/">Learning</a><a href="/about/">About</a>
        <a href={SITE.links.linkedin} rel="me noopener">LinkedIn</a><a href={SITE.links.github} rel="me noopener">GitHub</a><a href="/rss.xml">RSS</a>
      </nav>
    </div>
  </footer>
  <script>
    const nav = document.querySelector('[data-nav]');
    const onScroll = () => nav?.classList.toggle('solid', window.scrollY > 40);
    onScroll(); addEventListener('scroll', onScroll, { passive: true });
  </script>
</body>
</html>
